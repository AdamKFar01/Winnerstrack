{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "rootDir": "static/ts",
        "outDir": "static/js",
        "strict": false,
        "noImplicitAny": false,
        "removeComments": false,
        "skipLibCheck": true
    },
    "include": ["static/ts/**/*"]
}
