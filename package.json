{
    "name": "winnerstrackbuilder",
    "version": "1.0.0",
    "description": "Personal productivity tracker",
    "author": "Adam Farhat",
    "main": "main.js",
    "scripts": {
        "start": "tsc && electron .",
        "build": "tsc && electron-builder --mac"
    },
    "devDependencies": {
        "electron": "^43.0.0",
        "electron-builder": "^26.0.0",
        "typescript": "^6.0.3"
    },
    "build": {
        "appId": "com.adam.winnerstrackbuilder",
        "productName": "WinnersTrack",
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "build/icon.png",
            "target": [
                {
                    "target": "dir",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "files": [
            "main.js",
            "package.json"
        ],
        "extraResources": [
            "app.py",
            "calendar_sync.py",
            "migrate_database.py",
            {
                "from": "templates",
                "to": "templates"
            },
            {
                "from": "static",
                "to": "static"
            }
        ]
    }
}
